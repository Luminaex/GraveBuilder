<Project Sdk="Microsoft.NET.Sdk">

  <!-- Shared settings and references: ..\Directory.Build.props. Version: ..\Versions.props. -->
  <PropertyGroup>
    <AssemblyName>GraveBuilder</AssemblyName>
    <UseUnityUI>true</UseUnityUI>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GraveFramework\GraveFramework.csproj">
      <!-- Deployed as its own plugin; don't copy a second framework DLL into this output. -->
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

  <!-- ImageConversion.LoadImage (PNG/JPEG decoding) for the map builder's LOAD IMAGE. -->
  <ItemGroup>
    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>$(ManagedDir)\UnityEngine.ImageConversionModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
